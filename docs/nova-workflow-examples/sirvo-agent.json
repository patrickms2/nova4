{
  "schemaVersion": 1,
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "position": { "x": 400, "y": 60 },
      "data": {
        "label": "User Message",
        "triggerType": "user_message",
        "outputVariable": "user_message"
      }
    },
    {
      "id": "action_knowledge",
      "type": "action",
      "position": { "x": 400, "y": 200 },
      "data": {
        "label": "Buscar Conocimiento Sirvo",
        "actionKey": "search-nova-knowledge",
        "inputMapping": "{\"message\": \"{{user_message}}\", \"business_slug\": \"sirvo\", \"limit\": 5}",
        "outputVariable": "knowledge_results"
      }
    },
    {
      "id": "action_restaurants",
      "type": "action",
      "position": { "x": 400, "y": 340 },
      "data": {
        "label": "Info Restaurante",
        "actionKey": "call-mcp-tool",
        "inputMapping": "{\"server_slug\": \"sirvo-restaurants-mcp\", \"tool_name\": \"sirvo-restaurantes\", \"input\": {}}",
        "outputVariable": "restaurant_info"
      }
    },
    {
      "id": "action_reservations",
      "type": "action",
      "position": { "x": 400, "y": 480 },
      "data": {
        "label": "Reservas del Dashboard",
        "actionKey": "call-mcp-tool",
        "inputMapping": "{\"server_slug\": \"sirvo-restaurants-mcp\", \"tool_name\": \"sirvo-dashboard-reservations\", \"input\": {}}",
        "outputVariable": "reservations"
      }
    },
    {
      "id": "agent_reply",
      "type": "aiAgent",
      "position": { "x": 400, "y": 620 },
      "data": {
        "label": "Generar Respuesta",
        "prompt": "Eres el asistente del restaurante gestionado por Sirvo.\n\nInformación del restaurante:\n{{restaurant_info.result}}\n\nReservas actuales:\n{{reservations.result}}\n\nConocimiento adicional:\n{{knowledge_results.results}}\n\nMensaje del usuario: {{user_message}}\n\nResponde en español de forma amable. Si quiere reservar mesa, pide fecha, hora y número de comensales.",
        "outputVariable": "reply"
      }
    },
    {
      "id": "send_reply",
      "type": "sendMessage",
      "position": { "x": 400, "y": 760 },
      "data": {
        "label": "Enviar Respuesta",
        "messageType": "text",
        "messageContent": "{{reply}}"
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trigger_1", "target": "action_knowledge" },
    { "id": "e2", "source": "action_knowledge", "target": "action_restaurants" },
    { "id": "e3", "source": "action_restaurants", "target": "action_reservations" },
    { "id": "e4", "source": "action_reservations", "target": "agent_reply" },
    { "id": "e5", "source": "agent_reply", "target": "send_reply" }
  ]
}
