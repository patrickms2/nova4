{
  "schemaVersion": 1,
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "position": { "x": 400, "y": 60 },
      "data": {
        "label": "User Message",
        "triggerType": "user_message",
        "outputVariable": "user_message"
      }
    },
    {
      "id": "action_knowledge",
      "type": "action",
      "position": { "x": 400, "y": 200 },
      "data": {
        "label": "Buscar Conocimiento Taxilanz",
        "actionKey": "search-nova-knowledge",
        "inputMapping": "{\"message\": \"{{user_message}}\", \"business_slug\": \"taxilanz\", \"limit\": 4}",
        "outputVariable": "knowledge_results"
      }
    },
    {
      "id": "action_hotels",
      "type": "action",
      "position": { "x": 400, "y": 340 },
      "data": {
        "label": "Listar Hoteles",
        "actionKey": "call-mcp-tool",
        "inputMapping": "{\"server_slug\": \"taxilanz-hoteles-laravel\", \"tool_name\": \"hotel_list\", \"input\": {}}",
        "outputVariable": "hotels"
      }
    },
    {
      "id": "input_hotel",
      "type": "collectInput",
      "position": { "x": 400, "y": 480 },
      "data": {
        "label": "¿Desde qué hotel?",
        "prompt": "Hoteles disponibles:\n{{hotels.result}}\n\n¿Desde qué hotel necesitas el taxi?",
        "variableName": "hotel_name",
        "inputType": "text",
        "required": true
      }
    },
    {
      "id": "input_destination",
      "type": "collectInput",
      "position": { "x": 400, "y": 620 },
      "data": {
        "label": "¿Destino?",
        "prompt": "¿A dónde te llevo? (aeropuerto, otro hotel, dirección…)",
        "variableName": "destination",
        "inputType": "text",
        "required": true
      }
    },
    {
      "id": "action_price",
      "type": "action",
      "position": { "x": 400, "y": 760 },
      "data": {
        "label": "Listar Servicios",
        "actionKey": "call-mcp-tool",
        "inputMapping": "{\"server_slug\": \"taxilanz-hoteles-laravel\", \"tool_name\": \"servicios_list\", \"input\": {}}",
        "outputVariable": "servicios"
      }
    },
    {
      "id": "agent_reply",
      "type": "aiAgent",
      "position": { "x": 400, "y": 900 },
      "data": {
        "label": "Confirmar Reserva",
        "prompt": "Eres el asistente de Taxilanz, servicio de taxi en Lanzarote.\n\nHotel de recogida: {{hotel_name}}\nDestino: {{destination}}\nServicios disponibles: {{servicios.result}}\nConocimiento adicional: {{knowledge_results.results}}\n\nConfirma el trayecto con precio estimado y pregunta si quiere proceder con la reserva.",
        "outputVariable": "reply"
      }
    },
    {
      "id": "send_reply",
      "type": "sendMessage",
      "position": { "x": 400, "y": 1040 },
      "data": {
        "label": "Enviar Confirmación",
        "messageType": "text",
        "messageContent": "{{reply}}"
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trigger_1", "target": "action_knowledge" },
    { "id": "e2", "source": "action_knowledge", "target": "action_hotels" },
    { "id": "e3", "source": "action_hotels", "target": "input_hotel" },
    { "id": "e4", "source": "input_hotel", "target": "input_destination" },
    { "id": "e5", "source": "input_destination", "target": "action_price" },
    { "id": "e6", "source": "action_price", "target": "agent_reply" },
    { "id": "e7", "source": "agent_reply", "target": "send_reply" }
  ]
}
