        {
            "id": "php_code_node-0fc0c8d1-75a3-4876-bcef-db1e7b13b219",
            "type": "php_code_node",
            "position": {
                "x": 1215.0363366005859,
                "y": -533.7431554036418
            },
            "data": {
                "label": "Execute PHP",
                "description": "Run custom PHP code",
                "code": "use Firefly\\FilamentBlog\\Models\\Post;\n\n$full = $context->getFullContext();\n\n\/\/ ID record creato\/aggiornato dal ModelUpdateNode\n$postId =\n    $input['id']\n    ?? ($input['record']['id'] ?? null)\n    ?? ($full['id'] ?? null)\n    ?? ($full['record']['id'] ?? null);\n\nif (! $postId) {\n    throw new \\RuntimeException('Post ID not found in input\/context.');\n}\n\n$post = Post::query()->find($postId);\n\nif (! $post) {\n    throw new \\RuntimeException(\"Post not found: {$postId}\");\n}\n\n\/\/ IDs arrivati dal webhook (o dal contesto)\n$categoryIds = $full['category_ids'] ?? [];\n$tagIds = $full['tag_ids'] ?? [];\n\n$categoryIds = is_array($categoryIds) ? array_values(array_filter($categoryIds, fn ($v) => is_numeric($v))) : [];\n$tagIds = is_array($tagIds) ? array_values(array_filter($tagIds, fn ($v) => is_numeric($v))) : [];\n\n\/\/ Sync relazioni se esistono\nif (method_exists($post, 'categories')) {\n    $post->categories()->sync($categoryIds);\n}\n\nif (method_exists($post, 'tags')) {\n    $post->tags()->sync($tagIds);\n}\n\n\/\/ Ritorna output “ricco” per i nodi downstream\n$post->refresh();\nif (method_exists($post, 'loadMissing')) {\n    $post->loadMissing(['categories', 'tags']);\n}\n\nreturn array_merge(\n    is_array($input) ? $input : ['input' => $input],\n    [\n        'id' => $post->id,\n        'record' => $post->toArray(),\n        'attached_category_ids' => $categoryIds,\n        'attached_tag_ids' => $tagIds,\n    ]\n);",
                "output_fields": "",
                "isNew": true,
                "icon": "heroicon-o-code-bracket",
                "iconType": "heroicon",
                "logoUrl": null,
                "logoMissing": false,
                "color": "slate",
                "display_name": "PHP Code",
                "id": "php_code_node-0fc0c8d1-75a3-4876-bcef-db1e7b13b219",
                "outputFields": "",
                "_v": 1
            },
