            "data": {
                "content": "curl -X POST \"PASTE HERE WEBHOOK ENDPOINT\" \\\n  -H \"Content-Type: application\/json\" \\\n  -H \"Accept: application\/json\" \\\n  --data-binary @- <<'JSON'\n{\n  \"title\": \"Post's title\",\n  \"slug\": \"posts-title\",\n  \"body\": \"<p>Post's <strong>content<\/strong>.<\/p>\",\n  \"sub_title\": \"Subtitle of the post\",\n  \"category_ids\": [1,2],\n  \"tag_ids\": [1,2],\n  \"user_id\": 1,\n  \"id\": 1,\n  \"cover_photo_path\": \"\",\n  \"photo_alt_text\": \"\",\n  \"published_at\": \"2026-04-10T12:00:00\",\n  \"scheduled_for\": null\n}\nJSON",
