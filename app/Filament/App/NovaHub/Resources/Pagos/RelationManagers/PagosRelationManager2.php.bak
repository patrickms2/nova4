<?php

namespace App\Filament\App\NovaHub\Resources\Pagos\RelationManagers;



use App\Filament\App\NovaHub\Resources\Pagos\PagoResource;
use App\Models\Taxi\TipoUsuario;
use App\Models\Taxi\PagoServicio;
use App\Models\Taxi\Pago;

use App\Enums\PagoEstado;

use App\Services\PagoServicioRefService;
use Archilex\AdvancedTables\Filters\AdvancedFilter;
use Carbon\Carbon;
use Filament\Actions\Action;
use Filament\Actions\BulkActionGroup;
use Filament\Actions\CreateAction;
use Filament\Actions\DeleteAction;
use Filament\Actions\DeleteBulkAction;
use Filament\Actions\EditAction;
use Filament\Forms;
use Livewire\Component;
use Filament\Forms\Components\DateTimePicker;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\Toggle;
use Filament\Forms\Components\ToggleButtons;
use Filament\Schemas\Components\Section;
use Filament\Schemas\Components\Tabs\Tab;
use Filament\Schemas\Components\Utilities\Get;
use Filament\Schemas\Components\Utilities\Set;
use Filament\Schemas\Schema as Form;
use Filament\Resources\RelationManagers\RelationManager;
use Filament\Tables;
use Filament\Tables\Columns\TextColumn;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Support\HtmlString;
use Illuminate\Support\Str;
use function Amp\Http\Server\redirectTo;


class PagosRelationManager2 extends RelationManager
{
    /**
     * Nombre de la relación que queremos gestionar (debe coincidir con el método
     * de relación en el modelo `Usuario`).
     */
    protected static string $relationship = 'pagos';

    /**
     * Atributo de título para los registros.
     */
    protected static ?string $recordTitleAttribute = 'nombre';

    /**
     * Configura la tabla que mostrará las ubicaciones relacionadas.
     */

    public function form(Form $form): Form
    {
        return $form
            ->schema([
                Section::make('Pago')
                    ->icon('euro')
                    ->live(true)
                    ->columns(4)
                    ->schema([
                        Forms\Components\TextInput::make('fecha_pago')
                            ->label('F. Pago')
                            ->default(now()),
                        Forms\Components\TextInput::make('ref_pago')
                            ->maxLength(155)
                            ->default(fn () => 'PAG-' . mb_strtoupper(mb_substr(md5(time()), 0, 8)))
                            ->columns(1),
                        Forms\Components\TextInput::make('importe')
                            ->label('Imp. Pagar')
                            ->required()
                            ->live()
                            ->afterStateUpdated(function (Get $get, Set $set, $state) {
                                $set('importe2',  $get('importe'));
                            })
                            ->reactive()

                            ->columnSpan('lg')
                            ->default(
                                function (PagoServicio|null $record,Get $get,Set $set) {
                                    if($record != null) {
                                        $set('importe', $record->importe);
                                        return $get('importe');
                                    }else return 0;
                                }
                            )
                            ->suffixActions([

                                Action::make('resto')
                                    ->icon('heroicon-m-currency-euro')
                                    ->size('md')
                                    ->action(function (Set $set, $state,PagoServicio|null $record,Get $get) {
                                        if($record != null) {
                                            $set('importe', $record->total - $record->importe);
                                        }else $set('importe',$get('total'));
                                        return $get('importe');
                                    }),
                                Action::make('mitad')
                                    ->icon('heroicon-m-currency-euro')
                                    ->size('xs')
                                    ->action(function (Set $set, $state,PagoServicio|null $record,Get $get) {
                                        if($record != null) {
                                            $set('importe', $record->total - $record->importe);
                                        }else $set('importe',$get('total')/2);
                                        return $get('importe');
                                    }),
                                Action::make('todo')

                                    ->label('Pagar')
                                    ->icon('heroicon-o-credit-card')
                                    ->size('xs')
                                    ->action(function (Action $action, $set, $state,PagoServicio|null $record,Get $get) {
                                        $idPago = "";
                                        if($record == null) {
                                            $id = "";
                                            $referencia = PagoServicioRefService::generateUsingNextAutoIncrement();
                                            $nuevoPagado = $get('total');
                                            $updateData = [
                                                'pagado' => $nuevoPagado,
                                                'metodo_pago' => 'R',
                                                'importe' => $get('total'),
                                                'status' => PagoEstado::PENDIENTE,
                                                'fecha_pago' => Carbon::now()->addDays(1)->addHour(2)->format('Y-m-d H:i:s'),
                                                'ref_pago' => 'PAG-' . mb_strtoupper(mb_substr(md5(time()), 0, 8)),
                                                'usuario_id' => auth()->id(),
                                            ];

                                            if ($nuevoPagado >= $get("total")) {
                                                $updateData['status'] = PagoEstado::PAGADO;
                                            } elseif ($nuevoPagado > 0) {
                                                $updateData['status'] = PagoEstado::PAGO_PARCIAL;
                                            } else {
                                                $updateData['status'] = PagoEstado::PENDIENTE;
                                            }
                                            // Actualizar primero en BD

                                            $idPago = Pago::insertGetId($updateData);

                                        }else
                                            $idPago = $record->id;


                                        Notification::make()
                                            ->title('Abriendo Redsys')
                                            ->body('Redirigiendo al TPV en una nueva pestaña...')
                                            ->success()
                                            ->send();


                                        $url = route('redsys.pay.fromPago', ['pago' => $idPago]);
                                        return redirect($url);
                                        return $action->url(
                                            function (Pago $record,$idPago) {

                                                return route('redsys.pay.fromPago', ['pago' => $record->id]);
                                            }, shouldOpenInNewTab: true);

                                    }),


                            ]),

                        Select::make('metodo_pago')
                            ->label('Metodo Pago')
                            ->options([
                                'C' => 'Contado',
                                'T' => 'Transf.',
                                'R' => 'Redsys',
                            ])
                            ->default('C'),

                    ])
                    ->compact(),
            ]);
    }


    public function table(Table $table): Table
    {
        $tabla = $table;

        return $table
            ->defaultSort('id', 'desc')
            ->headerActions([
                CreateAction::make()
                    ->fillForm(fn () => [
                        'usuario_id' => $this->getOwnerRecord()->usuario_id,

                    ])
                    // Asegura que siempre se guarde asociado al taxista actual
                    ->mutateFormDataUsing(function (array $data): array {
                        $data['usuario_id'] = $this->getOwnerRecord()->usuario_id;
                        return $data;
                    })
                    ->after(function (PagoServicio $record,Component $livewire) {
                        $this->refreshOwnerPago();

                        $livewire->dispatch('refreshPagos');
                    }),

                //->slideOver()

            ])
            ->columns([

                Tables\Columns\TextColumn::make('id')
                    ->toggleable(isToggledHiddenByDefault: true)
                    ->toggleable(true)
                    ->label('ID')
                    ->badge()
                    ->sortable(),
                Tables\Columns\TextColumn::make('pago.referencia')
                    ->toggleable(isToggledHiddenByDefault: false)
                    ->toggleable(true)
                    ->label('Pago ID')
                    ->badge()
                    ->sortable(),
                TextColumn::make('ref_pago')
                    ->toggleable(isToggledHiddenByDefault: true)
                    ->label('R.Pago')
                    ->formatStateUsing(function ($state,$record){
                        if($record->ref_pago != null)
                            return $state . '/'."<br>".$record->ref_pago;
                        else
                            return $state;
                    })
                    ->extraAttributes(['style' => 'font-weight: bold']) // Aplica negritas
                    ->searchable()
                    ->sortable()
                    ->html(true)
                    ->toggleable(true),
                Tables\Columns\TextColumn::make('importe')
                    ->toggleable(isToggledHiddenByDefault: false)
                    ->sortable()
                    ->toggleable(true)
                    ->label('Imp. Pagado')
                    ->formatStateUsing(fn ($state,$record) => $state . ' €')
                    ->searchable(),
                Tables\Columns\TextColumn::make('metodo_pago')
                    ->toggleable(isToggledHiddenByDefault: false)
                    ->label('M. Pago')
                    ->sortable()
                    ->toggleable(true),
                Tables\Columns\TextColumn::make('status')
                    ->toggleable(isToggledHiddenByDefault: false)
                    ->label('status')
                    ->sortable()
                    ->toggleable(true),

                Tables\Columns\TextColumn::make('updated_at')
                    ->toggleable(isToggledHiddenByDefault: true)
                    ->dateTime()
                    ->sortable()
                    ->toggleable(true),
                Tables\Columns\TextColumn::make('created_at')
                    ->toggleable(isToggledHiddenByDefault: true)
                    ->dateTime()
                    ->sortable()
                    ->toggleable(true),
            ])
            ->filters([
                AdvancedFilter::make(),
            ])
            ->recordActions([
                EditAction::make()
                    ->after(function (Component $livewire) {
                        $livewire->dispatch('refreshPagos');
                    }),
                DeleteAction::make()
                    ->after(function ($record): void {
                        $this->refreshOwnerPago();
                    }),
            ])
            ->bulkActions([
                BulkActionGroup::make([
                    DeleteBulkAction::make(),
                ]),
            ]);
    }

    private function refreshOwnerPago(): void
    {
        $pago = $this->getOwnerRecord();

        if (! $pago) {
            return;
        }
        $sum = (float) $pago->pagos()->sum('importe');

        $update = [
            'pagado' => $sum,
        ];

        if ($sum >= (float) $pago->importe) {
            $update['status'] = PagoEstado::PAGADO;
        } elseif ($sum > 0) {
            $update['status'] = PagoEstado::PAGO_PARCIAL;
        } else {
            $update['status'] = PagoEstado::PENDIENTE;
        }

        $pago->forceFill($update)->save();
    }

}
