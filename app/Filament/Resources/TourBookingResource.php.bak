<?php

namespace App\Filament\Resources;

use App\Models\TourBooking;
use Archilex\AdvancedTables\AdvancedTables;
use Filament\Actions;
use Filament\Resources\Resource;
use Filament\Schemas\Schema as Form;
use Filament\Tables;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Builder;

class TourBookingResource extends Resource
{
    use AdvancedTables;

    protected static ?string $model = TourBooking::class;

    protected static string|\BackedEnum|null $navigationIcon = 'heroicon-o-clipboard-document-check';

    protected static string|\UnitEnum|null $navigationGroup = 'Tours';
    protected static ?string $navigationParentGroup = 'Catálogo';

    protected static ?string $navigationLabel = 'Reservas Tours';

    protected static ?int $navigationSort = 50;

    public static function canAccess(): bool
    {
        return true;
    }

    public static function shouldRegisterNavigation(): bool
    {
        return false;
    }

    public static function getEloquentQuery(): Builder
    {
        return parent::getEloquentQuery();
    }

    /*return parent::getEloquentQuery()
    ->whereHas('tour', function ($query) {
        $query->where('admin_id', auth()->id());
    });*/

    public static function form(Form $form): Form
    {
        return $form
            ->schema([
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->defaultSort('id', 'desc')
            ->columns([
                Tables\Columns\TextColumn::make('id')
                    ->label('ID')
                    ->searchable()
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('tour.name')
                    ->numeric()
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('tour.activities.name')
                    ->label('Activities')
                    ->formatStateUsing(fn ($state, $record) => $record->tour->activities->pluck('name')->join(', ')
                    )
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('user.first_name')
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('base_price')
                    ->label('Base price')
                    ->money('EUR')
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('booking.total_price')
                    ->label('Total')
                    ->money('EUR')
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('booking.status')
                    ->label('Status')
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('booking.payment_status')
                    ->label('payment status')
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('booking.discount_amount')
                    ->label('discount')
                    ->money('EUR')
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('number_of_adults')
                    ->toggleable(isToggledHiddenByDefault: false),
                Tables\Columns\TextColumn::make('number_of_children')
                    ->toggleable(isToggledHiddenByDefault: false),
            ])
            ->filters([
                //
            ])
            ->actions([
                Actions\ViewAction::make(),
                Actions\EditAction::make(),
            ])
            ->bulkActions([
                Actions\BulkActionGroup::make([
                    Actions\DeleteBulkAction::make(),
                ]),
            ]);
    }

    public static function getRelations(): array
    {
        return [
            //
        ];
    }

    public static function canCreate(): bool
    {
        return true;
    }

    public static function getPages(): array
    {
        return [
            'index' => \App\Filament\TourAdmin\Resources\TourBookingResource\Pages\ListTourBookings::route('/'),
            'create' => \App\Filament\TourAdmin\Resources\TourBookingResource\Pages\CreateTourBooking::route('/create'),
            'view' => \App\Filament\TourAdmin\Resources\TourBookingResource\Pages\ViewTourBooking::route('/{record}'),
            'edit' => \App\Filament\TourAdmin\Resources\TourBookingResource\Pages\EditTourBooking::route('/{record}/edit'),
        ];
    }
}
